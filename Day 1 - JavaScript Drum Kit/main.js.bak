let buttons = document.querySelectorAll('.button');
console.log(buttons);

window.addEventListener('keydown', function(target){
	console.log(target.key)
	buttons.forEach((item, index) => {
		if(item.innerText == target.key.toUpperCase()){
			item.classList.add("playing"); //change the border color
			
			//play the sound
			let audioName = `${index}`
			let audio = document.getElementById(audioName);
			audio.currentTime = 0;
			audio.play();
			
		}
		setTimeout(function(){item.classList.remove("playing")}, 300); // restore initial border color after a second;
	})
})