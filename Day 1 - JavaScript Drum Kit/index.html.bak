<!DOCTYPE html>
<html>
	<head>
		<title>Drum Kit</title>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<h1>Type the letter in the box!</h1>
		<div id="container">
			<div class="button">S</div>
			<div class="button">D</div>
			<div class="button">F</div>
			<div class="button">J</div>
			<div class="button">K</div>
			<div class="button">L</div>
		</div>
		<audio id="0">
			<source src="sounds/0.mp3" type="audio/mpeg">
		</audio>
		<audio id="1">
			<source src="sounds/1.wav" type="audio/wav">
		</audio>
		<audio id="2">
			<source src="sounds/2.mp3" type="audio/mpeg">
		</audio>
		<audio id="3">
			<source src="sounds/3.mp3" type="audio/mpeg">
		</audio>
		<audio id="4">
			<source src="sounds/4.mp3" type="audio/mpeg">
		</audio>
		<audio id="5">
			<source src="sounds/5.mp3" type="audio/mpeg">
		</audio>
		<audio id="6">
			<source src="sounds/6.mp3" type="audio/mpeg">
		</audio>
		<script src="main.js"></script>
	</body>
</html>