<!DOCTYPE html>
<html>
	<head>
		<title>CSS + JS Clock</title>
		<link rel="stylesheet" href="style.css">
	</head>
	
	<body>
		<div id="container">
			<div id="circle">
				<div id="hours" class="indicator"></div>
				<div id="minutes" class="indicator"></div>
				<div id="seconds" class="indicator"></div>
			</div>
		</div>
		<div id="trial">
		
		</div>
		<script src="main.js"></script>
	</body>
</html>