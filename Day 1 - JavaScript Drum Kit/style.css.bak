body {
	background-image: url('images/background.png');
	text-align: center;
}

h1 {
	position: absolute;
	top: 20%;
}

#container {
	border: 2px solid black;
	margin: 100px 50px 0 50px;
	display: flex;
	justify-content: space-evenly;
	align-items: center;
	height: 400px;
}

.button {
	border: 2px solid white;
	width: 100px;
	height : 100px;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 2.5em;
	color: white;
	background: black;
}

.button:hover {
	border-color: red;
}
